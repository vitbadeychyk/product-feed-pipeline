# PATHS
# ============================================================

BASE_DIR = Path(__file__).resolve().parents[2]

INPUT_FILE = (
    BASE_DIR
    / "data"
    / "raw"
    / "supplier_feed.xml"
)

OUTPUT_FILE = (
    BASE_DIR
    / "data"
    / "output"
    / "rozetka"
    / "rozetka_feed.xml"
)

